#include <iostream>
#include <stdexcept>

// Шаг 2–6: реализация рекурсивной функции
unsigned long long factorial(int n) {
    // Шаг 7: проверка граничных условий
    if (n < 0) {
        throw std::invalid_argument("Factorial of negative number is undefined");
    }
    
    // Шаг 4: базовый случай
    if (n <= 1) {
        return 1;
    }
    
    // Шаг 5–6: рекурсивный вызов и композиция результата
    return n * factorial(n - 1);
}

int main() {
    try {
        int number = 5;
        std::cout << number << "! = " << factorial(number) << std::endl;
    } catch (const std::exception& e) {
        std::cerr << "Error: " << e.what() << std::endl;
        return 1;
    }
    return 0;
}

Практическое задание. Вариант 8.
Реализуйте рекурсивную функцию для подсчета суммы элементов массива
#include <iostream>
#include <vector>

// Рекурсивная функция подсчёта суммы элементов массива
int arraySum(const int arr[], int size) {
    // Базовый случай: пустой массив
    if (size == 0) {
        return 0;
    }
    
    // Базовый случай: один элемент
    if (size == 1) {
        return arr[0];
    }
    
    // Рекурсивный вызов: сумма последнего элемента и суммы остальных
    return arr[size - 1] + arraySum(arr, size - 1);
}

int main() {
    // Пример массива
    int numbers[] = {1, 2, 3, 4, 5};
    int size = sizeof(numbers) / sizeof(numbers[0]);
    
    // Вычисление суммы
    int sum = arraySum(numbers, size);
    
    // Вывод результата
    std::cout << "Массив: ";
    for (int i = 0; i < size; ++i) {
        std::cout << numbers[i] << " ";
    }
    std::cout << "\nСумма элементов: " << sum << std::endl;
    
    return 0;
}
